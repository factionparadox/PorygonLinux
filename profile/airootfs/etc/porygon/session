#!/bin/sh
# Porygon X session. Lives here rather than ~/.xinitrc because MaXX's
# first-run setup replaces ~/.xinitrc with its own.
export USERNAME=$USER   # MaXX greets you by this name
# laptop keys (brightness, volume) - 5Dwm doesn't handle them itself
xbindkeys -f /etc/porygon/xbindkeysrc &
exec /opt/MaXX/etc/skel/Xsession.dt
