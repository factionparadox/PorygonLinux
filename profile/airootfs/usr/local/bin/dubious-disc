#!/bin/bash
# dubious-disc - update the system, then rebuild the AUR packages (MaXX,
# gtk2, the old libraries MaXX needs, liberated systemd) that have newer
# versions. Liberated systemd builds from its newest commit and takes a while.
[ "$(id -u)" = 0 ] && { echo "Run dubious-disc as your normal user, not root."; exit 1; }
start=$(date +%Y-%m-%dT%H:%M:%S)
pamac upgrade --aur --devel "$@" && upgrade pinned && porygon-record-evolution dubious-disc "$start"
