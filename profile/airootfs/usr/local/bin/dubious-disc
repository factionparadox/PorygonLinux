#!/bin/bash
# dubious-disc - full evolution: updates the system, then rebuilds Porygon's
# AUR packages (the MaXX desktop, gtk2 and the old libraries it needs) when
# the AUR has newer versions - including liberated systemd, rebuilt from
# its newest commit (that one takes a while). Manjaro's pamac does the work.
[ "$(id -u)" = 0 ] && { echo "Run dubious-disc as your normal user, not root."; exit 1; }
start=$(date +%Y-%m-%dT%H:%M:%S)
pamac upgrade --aur --devel "$@" && upgrade pinned && porygon-record-evolution dubious-disc "$start"
