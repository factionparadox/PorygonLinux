#!/bin/bash
# upgrade - Porygon's package tool (named for the item that evolves Porygon).
# A thin coat of paint over Manjaro's pamac.
#   upgrade                 update the system
#   upgrade install PKG..   install packages
#   upgrade remove PKG..    remove packages (and their unused deps)
#   upgrade search TERM     search the repos (add --aur to search the AUR too)
#   upgrade info PKG        details about a package
#   upgrade list            what you've installed
#   upgrade clean           clear the download cache
#   upgrade mirrors         pick the fastest Manjaro mirrors
# For the MaXX desktop and other AUR parts, use: dubious-disc
cmd=${1:-update}; shift 2>/dev/null
case $cmd in
  update|-u)      start=$(date +%Y-%m-%dT%H:%M:%S)
                  pamac upgrade && porygon-record-evolution upgrade "$start" ;;
  install|in|-i)  pamac install "$@" ;;
  remove|rm|-r)   pamac remove -o "$@" ;;
  search|s|-s)    if [ "${1:-}" = --aur ]; then shift; pamac search -a "$@"; else pamac search "$@"; fi ;;
  info)           pamac info "$@" ;;
  list|ls)        pamac list -e ;;
  clean)          pamac clean ;;
  mirrors)        sudo pacman-mirrors --fasttrack 10 && sudo pacman -Syy ;;
  help|-h|--help) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) echo "upgrade: unknown command '$cmd' (try: upgrade help)"; exit 1 ;;
esac
