#!/bin/bash
# upgrade - install, remove and update software.
#   upgrade                 update the system
#   upgrade install PKG..   install packages, choosing where each comes
#                           from: Manjaro stable, testing, unstable, or AUR
#   upgrade branches        programs pinned to testing/unstable (and unpin)
#   upgrade later           download updates now, install them at shutdown
#   upgrade undo            go back to how the system was before an update
#   upgrade remove PKG..    remove packages (and their unused deps)
#   upgrade search TERM     search the repos (add --aur to search the AUR too)
#   upgrade info PKG        details about a package
#   upgrade list            what you've installed
#   upgrade clean           clear the download cache
#   upgrade mirrors         pick the fastest Manjaro mirrors
# For the MaXX desktop and other AUR parts, use: dubious-disc
cmd=${1:-update}; shift 2>/dev/null

B='\e[1;38;2;120;160;210m' P='\e[1;38;2;236;132;157m' N='\e[0m'

# --- Manjaro branches -------------------------------------------------------
# Your system follows stable. A program can be pinned to testing or unstable:
# each branch gets its own package lists (in /var/lib/porygon/branches/NAME,
# sharing the system's installed-package database), and `upgrade` keeps
# pinned programs on their branch. Pins live in /etc/porygon/branches.list.
PINS=/etc/porygon/branches.list
BR=/var/lib/porygon/branches
branch_conf() {   # branch_conf testing -> path to a pacman.conf for that branch
    local b=$1 c=/etc/porygon/pacman-$1.conf mirror
    mirror=$(grep -m1 '^Server' /etc/pacman.d/mirrorlist | sed 's/^Server *= *//')
    mirror=${mirror/\/stable\//\/$b\/}
    if [ ! -f "$c" ] || ! grep -qF "$mirror" "$c"; then
        sudo mkdir -p "$BR/$b/sync" /etc/porygon
        [ -e "$BR/$b/local" ] || sudo ln -s /var/lib/pacman/local "$BR/$b/local"
        sed -e "s|^#\?DBPath.*|DBPath = $BR/$b/|" -e '/^Include *= *\/etc\/pacman.d\/mirrorlist/d' /etc/pacman.conf |
            sudo tee "$c" >/dev/null
        grep -q '^DBPath' "$c" || sudo sed -i "s|^\[options\]|[options]\nDBPath = $BR/$b/|" "$c"
        for r in core extra multilib; do
            grep -q "^\[$r\]" "$c" && sudo sed -i "/^\[$r\]/a Server = $mirror" "$c"
        done
    fi
    echo "$c"
}
refresh_branches() {   # fetch testing/unstable package lists (once per run)
    [ -n "${_refreshed:-}" ] && return; _refreshed=1
    local b; for b in testing unstable; do sudo pacman --config "$(branch_conf $b)" -Sy >/dev/null 2>&1; done
}
pin()   { sudo touch "$PINS"; sudo sed -i "/^$1 /d" "$PINS"; [ -n "${2:-}" ] && echo "$1 $2" | sudo tee -a "$PINS" >/dev/null; true; }
pinned_branch() { [ -f "$PINS" ] && awk -v n="$1" '$1 == n { print $2 }' "$PINS"; }

# install_one NAME - list every source that has NAME (each Manjaro branch and
# the AUR), let you pick one by number, then install it from there
install_one() {
    local name=$1 i n choice b
    local -a src=() ver=() br=()
    while read -r repo v; do src+=("$repo"); ver+=("$v"); br+=(stable); done \
        < <(pacman -Sl 2>/dev/null | awk -v n="$name" '$2 == n { print $1, $3 }')
    refresh_branches
    for b in testing unstable; do
        while read -r repo v; do
            # only list a branch when it offers something stable doesn't
            [[ " ${ver[*]} " == *" $v "* ]] && continue
            src+=("$repo"); ver+=("$v"); br+=("$b")
        done < <(pacman --config "/etc/porygon/pacman-$b.conf" -Sl 2>/dev/null | awk -v n="$name" '$2 == n { print $1, $3 }')
    done
    local aur
    aur=$(/usr/lib/porygon/aur-guard info "$name" 2>/dev/null |
          python3 -c 'import json,sys; r=json.load(sys.stdin); print(next(iter(r.values()))["Version"] if r else "")' 2>/dev/null)
    [ -n "$aur" ] && { src+=(aur); ver+=("$aur"); br+=(aur); }

    if [ ${#src[@]} -eq 0 ]; then
        # not a package name: maybe a group or something another package provides
        echo -e "${B}::${N} '$name' isn't a package in Manjaro or the AUR - asking pamac"
        pamac install "$name"; return
    fi
    local have; have=$(pacman -Q "$name" 2>/dev/null | cut -d' ' -f2)
    local now; now=$(pinned_branch "$name")
    if [ ${#src[@]} -eq 1 ]; then
        choice=0
        echo -e "${B}::${N} $name ${ver[0]} from $(label "${br[0]}" "${src[0]}")"
    else
        echo -e "${B}::${N} ${P}$name${N} is available from:${have:+  (installed: $have${now:+, pinned to $now})}"
        for i in "${!src[@]}"; do
            printf "   %d) %-28s %s\n" $((i + 1)) "$(label "${br[$i]}" "${src[$i]}")" "${ver[$i]}"
        done
        read -rp "   Install from which? [1]: " n
        n=${n:-1}
        [[ $n =~ ^[0-9]+$ ]] && (( n >= 1 && n <= ${#src[@]} )) || { echo "   Not one of the choices - skipping $name."; return 1; }
        choice=$((n - 1))
    fi
    case ${br[$choice]} in
        aur)    /usr/lib/porygon/aur-guard check "$name" && pamac build "$name" && pin "$name" ;;
        stable) sudo pacman -S --needed "${src[$choice]}/$name" && pin "$name" ;;
        *)      sudo pacman --config "/etc/porygon/pacman-${br[$choice]}.conf" -S --needed "${src[$choice]}/$name" &&
                { pin "$name" "${br[$choice]}"; echo -e "${B}::${N} $name is pinned to ${br[$choice]}: 'upgrade' keeps it there (undo with 'upgrade branches')."; } ;;
    esac
}
# update pinned programs from their branches (after the normal stable update)
update_pinned() {
    [ -s "$PINS" ] || return 0
    refresh_branches
    local b pk
    for b in testing unstable; do
        pk=$(awk -v b="$b" '$2 == b { print $1 }' "$PINS" | xargs)
        [ -n "$pk" ] && { echo -e "${B}::${N} Updating programs pinned to $b: $pk"; sudo pacman --config "/etc/porygon/pacman-$b.conf" -S --needed --noconfirm $pk; }
    done
}
# before an update: Manjaro's known issues for anything newer than your last update
known_issues() {
    /usr/lib/porygon/known-issues
    [ $? = 1 ] || return 0
    read -rp "   Go ahead with the update? [Y/n] " a
    [[ ${a,,} != n* ]]
}
# after an update: AUR programs that no longer load, and dependencies built
# from Arch's recipes that Manjaro stable has now caught up with
after_update() {
    local rec=/var/lib/porygon/source-built line name ver
    if [ -s "$rec" ]; then
        while read -r name ver _; do
            [ "$(pacman -Q "$name" 2>/dev/null | cut -d' ' -f2)" = "${ver#*-}" ] || [ "$(pacman -Q "$name" 2>/dev/null | cut -d' ' -f2)" = "$ver" ] ||
                { sudo sed -i "/^$name /d" "$rec"; echo -e "${B}::${N} $name now comes from Manjaro again."; }
        done < <(cat "$rec")
    fi
    local broken; broken=$(/usr/lib/porygon/aur-guard broken)
    [ -n "$broken" ] || return 0
    echo -e "${B}::${N} These AUR programs were built against libraries that this update replaced:"
    printf '   %s\n' "${broken//$'\t'/  -  }"
    read -rp "   Rebuild them now? [Y/n] " a
    [[ ${a,,} == n* ]] && return 0
    local p; for p in $(cut -f1 <<< "$broken"); do /usr/lib/porygon/aur-guard check "$p" && pamac build --no-confirm "$p"; done
}
label() { case $1 in aur) echo "AUR (built here)" ;; *) echo "Manjaro $1 ($2)" ;; esac; }
case $cmd in
  pinned)         update_pinned ;;
  known)          known_issues ;;
  check)          after_update ;;
  update|-u)      start=$(date +%Y-%m-%dT%H:%M:%S)
                  known_issues || exit 0
                  pamac upgrade && update_pinned && after_update && porygon-record-evolution upgrade "$start" ;;
  later)          known_issues || exit 0
                  pamac upgrade --download-only && sudo touch /system-update &&
                      echo -e "${B}::${N} Updates downloaded. They'll be installed when you next shut down or restart." ;;
  undo)           exec porygon-undo "$@" ;;
  branches)       if [ ! -s "$PINS" ]; then echo "Nothing is pinned - everything follows Manjaro stable."; exit 0; fi
                  echo -e "${B}::${N} Pinned programs:"; nl -w4 -s') ' "$PINS"
                  read -rp "   Unpin which (number, Enter for none)? " n
                  [[ $n =~ ^[0-9]+$ ]] || exit 0
                  p=$(sed -n "${n}p" "$PINS" | cut -d' ' -f1); [ -n "$p" ] || exit 1
                  pin "$p"; echo "   $p follows stable again (it moves back when stable catches up)." ;;
  install|in|-i)  [ $# -gt 0 ] || { echo "usage: upgrade install PKG.."; exit 1; }
                  for p in "$@"; do install_one "$p"; done ;;
  remove|rm|-r)   pamac remove -o "$@" ;;
  search|s|-s)    if [ "${1:-}" = --aur ]; then shift; pamac search -a "$@"; else pamac search "$@"; fi ;;
  info)           pamac info "$@" ;;
  list|ls)        pamac list -e ;;
  clean)          pamac clean ;;
  mirrors)        sudo pacman-mirrors --fasttrack 10 && sudo pacman -Syy ;;
  help|-h|--help) sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) echo "upgrade: unknown command '$cmd' (try: upgrade help)"; exit 1 ;;
esac
