#!/bin/bash
# porygon-install - copies the running live system onto a disk.
# Wipes the chosen disk: 2 GiB EFI partition (Limine, kernels, a kernel per
# snapshot) + Btrfs root in subvolumes, with Snapper taking a snapshot before
# every update and each snapshot bootable from the Limine menu.
#
#   porygon-install              ask in the terminal
#   porygon-install --list-disks the disks it can install to (for the wizard)
#   porygon-install --batch      no questions: DISK USERNAME HOST TZONE KB from
#                                the environment, the password on stdin; prints
#                                "@@ STEP percent text" lines for porygon-installer
set -euo pipefail
[ "$(id -u)" = 0 ] || exec sudo "$0" "$@"
MODE=ask; case ${1:-} in --batch) MODE=batch ;; --list-disks) MODE=list ;; esac

B='\e[1;38;2;120;160;210m'; N='\e[0m'
STEP=0
say() { STEP=$((STEP + 1)); if [ $MODE = batch ]; then echo "@@ ${STEP_PCT:-0} $*"; else printf "${B}::${N} %s\n" "$*"; fi; }
die() { if [ $MODE = batch ]; then echo "!! $*"; else printf '\e[1;31m!!\e[0m %s\n' "$*"; fi; exit 1; }

[ -d /sys/firmware/efi ] || die "Porygon installs in UEFI mode only. Reboot the USB in UEFI mode."
[ -d /run/archiso ] || die "Run this from the Porygon live USB."
PKGS=/usr/share/porygon/pkgs        # the boot tools, installed only on the target

live_disk=$(lsblk -no PKNAME "$(findmnt -no SOURCE /run/archiso/bootmnt 2>/dev/null)" 2>/dev/null || true)
mapfile -t disks < <(lsblk -dpno NAME,TYPE,RM | awk '$2=="disk"{print $1}' | grep -v -e '/dev/loop' -e '/dev/zram' -e '/dev/fd' ${live_disk:+-e "/dev/$live_disk\$"})
if [ $MODE = list ]; then
    for d in "${disks[@]}"; do printf '%s\t%s\t%s\n' "$d" "$(lsblk -dno SIZE "$d" | xargs)" "$(lsblk -dno MODEL "$d" | xargs)"; done
    exit 0
fi
[ ${#disks[@]} -gt 0 ] || die "No disks found to install to."

if [ $MODE = batch ]; then
    : "${DISK:?}" "${USERNAME:?}" "${HOST:=porygon}" "${TZONE:=Europe/London}" "${KB:=gb}"
    IFS= read -r PW1
    printf '%s\n' "${disks[@]}" | grep -qx "$DISK" || die "$DISK isn't a disk Porygon can install to."
    [[ $USERNAME =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || die "Usernames are lowercase letters, numbers, - and _."
    [ -n "$PW1" ] || die "The password is empty."
    [ -f "/usr/share/zoneinfo/$TZONE" ] || die "Unknown time zone '$TZONE'."
else
clear
printf "${B}PORYGON INSTALLER${N}\n\n"
say "Disks:"
for i in "${!disks[@]}"; do
    d=${disks[$i]}
    printf "   %d) %-14s %8s  %s\n" $((i+1)) "$d" "$(lsblk -dno SIZE "$d" | xargs)" "$(lsblk -dno MODEL "$d" | xargs)"
done
read -rp "   Install to disk number: " n
[[ $n =~ ^[0-9]+$ ]] && (( n >= 1 && n <= ${#disks[@]} )) || die "Not a disk number."
DISK=${disks[$((n-1))]}

# --- user ---
echo
read -rp "   Your username: " USERNAME
[[ $USERNAME =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || die "Usernames are lowercase letters, numbers, - and _."
while :; do
    read -rsp "   Password: " PW1; echo
    read -rsp "   Password again: " PW2; echo
    [ -n "$PW1" ] && [ "$PW1" = "$PW2" ] && break
    echo "   Those didn't match (or were empty) - try again."
done
read -rp "   Computer name [porygon]: " HOST; HOST=${HOST:-porygon}
TZ_DEFAULT=$(readlink /etc/localtime | sed 's|.*/zoneinfo/||'); [ "$TZ_DEFAULT" = UTC ] && TZ_DEFAULT=Europe/London
read -rp "   Time zone [$TZ_DEFAULT]: " TZONE; TZONE=${TZONE:-$TZ_DEFAULT}
[ -f "/usr/share/zoneinfo/$TZONE" ] || die "Unknown time zone '$TZONE'."
read -rp "   Keyboard layout [gb]: " KB; KB=${KB:-gb}

echo
printf '\e[1;31m   EVERYTHING on %s (%s) will be erased.\e[0m\n' "$DISK" "$(lsblk -dno SIZE "$DISK" | xargs)"
read -rp "   Type yes to continue: " ok
[ "$ok" = yes ] || die "Cancelled - nothing was changed."
fi

# --- partition ---
STEP_PCT=2 say "Partitioning $DISK"
umount -R /mnt 2>/dev/null || true
wipefs -af "$DISK" >/dev/null
sgdisk -Z "$DISK" >/dev/null
sgdisk -n1:0:+2G -t1:ef00 -c1:EFI -n2:0:0 -t2:8304 -c2:porygon "$DISK" >/dev/null
partprobe "$DISK"; udevadm settle
part() { lsblk -lpno NAME "$DISK" | sed -n "$(( $1 + 1 ))p"; }
ESP=$(part 1); ROOT=$(part 2)
mkfs.fat -F32 -n EFI "$ESP" >/dev/null
mkfs.btrfs -f -L porygon "$ROOT" >/dev/null
modprobe -q btrfs || true
udevadm settle
# subvolumes: the system, your home, logs and the package cache. Snapshots
# cover only @, so rolling back never touches your files or loses logs.
mount -t btrfs "$ROOT" /mnt
for sv in @ @home @log @pkg; do btrfs -q subvolume create "/mnt/$sv"; done
umount /mnt
OPTS=noatime,compress=zstd:1
mount -t btrfs -o subvol=/@,$OPTS "$ROOT" /mnt
mount --mkdir -t btrfs -o subvol=/@home,$OPTS "$ROOT" /mnt/home
mount --mkdir -t btrfs -o subvol=/@log,$OPTS "$ROOT" /mnt/var/log
mount --mkdir -t btrfs -o subvol=/@pkg,$OPTS "$ROOT" /mnt/var/cache/pacman/pkg
mount --mkdir -t vfat -o umask=0077 "$ESP" /mnt/boot

# --- copy the live system ---
STEP_PCT=8 say "Copying the system (a few minutes)"
RSYNC_PROGRESS=--info=progress2; [ $MODE = batch ] && RSYNC_PROGRESS="--info=progress2 --outbuf=L"
rsync -aAXH $RSYNC_PROGRESS --no-inc-recursive \
    --exclude={/dev/*,/proc/*,/sys/*,/run/*,/tmp/*,/mnt/*,/boot/*,/home/*,/var/cache/pacman/pkg/*,/var/log/*,/etc/machine-id,/etc/pacman.d/gnupg/*} \
    / /mnt/

# --- undo the live-USB bits ---
STEP_PCT=70 say "Configuring"
rm -f /mnt/etc/mkinitcpio.conf.d/archiso.conf \
      /mnt/etc/systemd/system/getty@tty1.service.d/autologin.conf \
      /mnt/etc/systemd/system/{pacman-init,livecd-alsa-unmuter}.service \
      /mnt/etc/systemd/system/etc-pacman.d-gnupg.mount \
      /mnt/etc/systemd/system/multi-user.target.wants/pacman-init.service \
      /mnt/etc/systemd/system/sound.target.wants/livecd-alsa-unmuter.service \
      /mnt/etc/systemd/journald.conf.d/volatile-storage.conf \
      /mnt/etc/systemd/logind.conf.d/do-not-suspend.conf \
      /mnt/etc/pacman.d/hooks/zzzz99-remove-custom-hooks-from-airootfs.hook \
      /mnt/etc/sudoers.d/porygon \
      /mnt/etc/tmpfiles.d/porygon-live.conf \
      /mnt/usr/local/bin/{livecd-sound,porygon-install}
rm -rf /mnt/usr/local/share/livecd-sound
sed -i '/^porygon:/d' /mnt/etc/passwd /mnt/etc/shadow
sed -i '/^porygon:/d' /mnt/etc/group /mnt/etc/gshadow
sed -i 's/,porygon//; s/:porygon$/:/' /mnt/etc/group /mnt/etc/gshadow
genfstab -U /mnt > /mnt/etc/fstab
echo "$HOST" > /mnt/etc/hostname
printf '\n  PORYGON  -  a 1990s workstation, rendered in polygons\n  upgrade: update the system    dubious-disc: update MaXX too\n  Manjaro edition: aged two weeks, like a fine cheese\n\n' > /mnt/etc/motd
ln -sf "/usr/share/zoneinfo/$TZONE" /mnt/etc/localtime
# the console names some layouts differently from X (gb on the desktop is uk here)
case $KB in gb) CONSOLE_KB=uk ;; *) CONSOLE_KB=$KB ;; esac
[ -n "$(find /usr/share/kbd/keymaps -name "$CONSOLE_KB.map*" -print -quit)" ] || CONSOLE_KB=us
echo "KEYMAP=$CONSOLE_KB" > /mnt/etc/vconsole.conf
echo "LANG=en_GB.UTF-8" > /mnt/etc/locale.conf
sed -i 's/^#\(en_GB.UTF-8\)/\1/; s/^#\(en_US.UTF-8\)/\1/' /mnt/etc/locale.gen
mkdir -p /mnt/etc/X11/xorg.conf.d
cat > /mnt/etc/X11/xorg.conf.d/00-keyboard.conf <<KBD
Section "InputClass"
    Identifier "keyboard"
    MatchIsKeyboard "on"
    Option "XkbLayout" "$KB"
EndSection
KBD
mkdir -p /mnt/etc/systemd/system/getty@tty1.service.d
cat > /mnt/etc/systemd/system/getty@tty1.service.d/autologin.conf <<AUTO
[Service]
ExecStart=
ExecStart=-/usr/bin/agetty --noreset --noclear --autologin $USERNAME - \${TERM}
AUTO

arch-chroot /mnt /bin/bash -e <<CHROOT
systemd-machine-id-setup >/dev/null 2>&1
locale-gen >/dev/null
hwclock --systohc || true
pacman-key --init >/dev/null 2>&1
pacman-key --populate manjaro archlinux >/dev/null 2>&1
useradd -m -G wheel,video,audio,input -s /bin/bash "$USERNAME"
echo '%wheel ALL=(ALL:ALL) ALL' > /etc/sudoers.d/10-wheel
chmod 440 /etc/sudoers.d/10-wheel
passwd -l root >/dev/null
CHROOT
printf '%s:%s\n' "$USERNAME" "$PW1" | arch-chroot /mnt chpasswd

# --- drivers: Manjaro's hardware detection picks the graphics driver ---
if ping -c1 -W3 mirror.init7.net >/dev/null 2>&1; then
    STEP_PCT=74 say "Choosing graphics drivers"
    arch-chroot /mnt /bin/bash -c 'pacman -Sy >/dev/null 2>&1; mhwd -a pci nonfree 0300 --noconfirm' >/dev/null 2>&1 ||
        say "Driver detection didn't finish; the open-source drivers stay (run 'sudo mhwd -a pci nonfree 0300' later)."
fi

# --- boot: Limine with Porygon's theme, kernels on the EFI partition ---
STEP_PCT=80 say "Setting up the boot menu and snapshots"
UUID=$(blkid -s UUID -o value "$ROOT")
cat > /mnt/etc/mkinitcpio.conf.d/porygon.conf <<'HOOKS'
# Porygon: boot splash early; btrfs-overlayfs lets a read-only snapshot boot
# with a temporary writable layer on top
HOOKS=(base udev plymouth autodetect microcode modconf kms keyboard keymap block filesystems btrfs-overlayfs)
HOOKS
cat > /mnt/etc/default/limine <<LIMINE
# Porygon's Limine settings (see /etc/limine-entry-tool.conf for every option)
TARGET_OS_NAME="Porygon"
ESP_PATH="/boot"
KERNEL_CMDLINE[default]="root=UUID=$UUID rootflags=subvol=/@ rw quiet splash loglevel=3"
ENABLE_LIMINE_FALLBACK=yes
# the kernel first (it's the default), then the snapshots
BOOT_ORDER="*, *fallback, Snapshots"
FIND_BOOTLOADERS=no
MAX_SNAPSHOT_ENTRIES=8
LIMINE
mkdir -p /mnt/boot/porygon
cp /usr/share/porygon/limine/background.png /mnt/boot/porygon/
cp /usr/share/porygon/limine/theme.conf /mnt/boot/limine.conf
# Porygon's own sudo rule: graphical admin tools (Btrfs Assistant) keep the display
echo 'Defaults env_keep += "DISPLAY XAUTHORITY"' > /mnt/etc/sudoers.d/20-display
chmod 440 /mnt/etc/sudoers.d/20-display
# the boot-menu tools aren't on the live system (their hooks would take over
# the USB's own start-up image), so they go straight onto the new one
mkdir -p /mnt/var/cache/porygon-pkgs; cp $PKGS/*.pkg.tar.zst /mnt/var/cache/porygon-pkgs/
arch-chroot /mnt /bin/bash -e <<'BOOT'
pacman -Rdd --noconfirm grub >/dev/null 2>&1 || true
rm -f /etc/default/grub
pacman -U --noconfirm --needed /var/cache/porygon-pkgs/*.pkg.tar.zst >/tmp/pacman-u.log 2>&1 || { cat /tmp/pacman-u.log; exit 1; }
rm -rf /var/cache/porygon-pkgs
limine-install >/dev/null
limine-mkinitcpio >/dev/null 2>&1
# snapshots: Snapper keeps up to 10 (5 marked important), none on a timer;
# snap-pac takes one before and after every update
snapper --no-dbus -c root create-config /
sed -i 's/^TIMELINE_CREATE=.*/TIMELINE_CREATE="no"/; s/^NUMBER_LIMIT=.*/NUMBER_LIMIT="10"/; s/^NUMBER_LIMIT_IMPORTANT=.*/NUMBER_LIMIT_IMPORTANT="5"/' /etc/snapper/configs/root
# only Porygon's start-up list (/etc/systemd/system-preset/10-porygon.preset)
systemctl preset-all >/dev/null 2>&1 || true
systemctl disable man-db.timer pamac-mirrorlist.timer snapper-timeline.timer >/dev/null 2>&1 || true
# do the first-boot housekeeping now (library cache, update stamps), so the
# first start isn't ten seconds slower than every other one
ldconfig; touch /etc/.updated /var/.updated
systemctl enable limine-snapper-sync.service snapper-cleanup.timer >/dev/null 2>&1
snapper --no-dbus -c root create -d "Porygon installed" -c number
limine-snapper-sync >/dev/null 2>&1 || true
BOOT
grep -q 'protocol: linux' /mnt/boot/limine.conf || die "Couldn't set up the boot menu."

sync
umount -R /mnt
STEP_PCT=100 say "Done. Remove the USB and reboot - you'll land straight in the desktop."
