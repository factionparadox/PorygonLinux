#!/usr/bin/env python3
"""porygon-nudge TITLE BODY [ID=Label ...]

A small reminder window in the bottom-right corner. Prints the ID of
the button you press (nothing if you close it or ignore it). It never grabs
the keyboard and it closes itself after three minutes.
"""
import sys, tkinter as tk
BG, PANEL, FIELD, PINK, INK = "#d9d3dd", "#c3bccb", "#f0c4d0", "#ec849d", "#1a1020"
title, body, acts = sys.argv[1], sys.argv[2], [a.split("=", 1) for a in sys.argv[3:]]
r = tk.Tk(); r.title("Porygon"); r.configure(bg=BG); r.resizable(False, False)
r.attributes("-topmost", True)
strip = tk.Frame(r, bg=PINK, bd=2, relief="raised"); strip.pack(fill="x")
try:
    ic = tk.PhotoImage(file="/usr/local/share/porygon/icons/logo-48.png")
except tk.TclError:
    try: ic = tk.PhotoImage(file="/usr/local/share/porygon/icons/welcome-48.png")
    except tk.TclError: ic = None
if ic: tk.Label(strip, image=ic, bg=PINK).pack(side="left", padx=8, pady=4)
tk.Label(strip, text=title, font=("Helvetica", 14, "bold italic"), bg=PINK, fg=INK).pack(side="left", padx=4)
tk.Label(r, text=body, font=("Helvetica", 11), bg=BG, fg=INK, wraplength=330, justify="left").pack(padx=14, pady=10, anchor="w")
row = tk.Frame(r, bg=BG); row.pack(fill="x", padx=12, pady=(0, 12))
def pick(i):
    if i: print(i)
    r.destroy()
for i, label in reversed(acts):
    tk.Button(row, text=label, command=lambda i=i: pick(i), bg=PANEL, activebackground=FIELD,
              bd=2, padx=10, font=("Helvetica", 11, "bold")).pack(side="right", padx=(6, 0))
r.update_idletasks()
w, h = r.winfo_width(), r.winfo_height()
r.geometry(f"+{r.winfo_screenwidth() - w - 24}+{r.winfo_screenheight() - h - 48}")
r.after(180000, r.destroy)
r.mainloop()
