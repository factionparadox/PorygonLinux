#!/usr/bin/env python3
"""Porygon's AUR guard.

    aur-guard check PKG     before an AUR build: find dependencies that Manjaro
                            stable can't satisfy, and build those from Arch's own
                            recipes first (only those - everything else comes
                            from Manjaro as usual)
    aur-guard broken        after an update: list AUR packages whose programs
                            or libraries no longer load
    aur-guard info PKG..    AUR info as JSON (cached for a day)

Dependencies built from source are recorded in /var/lib/porygon/source-built.
When Manjaro stable catches up, its newer package simply replaces the local
build at the next update, and the record is dropped.
"""
import json, os, re, subprocess, sys, time, urllib.parse, urllib.request
from pathlib import Path

CACHE = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "porygon"
AUR_CACHE = CACHE / "aur"
SRC = CACHE / "source"
RECORD = Path("/var/lib/porygon/source-built")
DAY = 24 * 3600
B, P, R, D, N = "\033[1;38;2;120;160;210m", "\033[1;38;2;236;132;157m", "\033[1;31m", "\033[2m", "\033[0m"
if not sys.stdout.isatty():
    B = P = R = D = N = ""


def say(msg):
    print(f"{B}::{N} {msg}", flush=True)


def fetch_json(url):
    req = urllib.request.Request(url, headers={"User-Agent": "porygon-aur-guard"})
    with urllib.request.urlopen(req, timeout=20) as r:
        return json.load(r)


def aur_info(names):
    """AUR RPC info, one request for everything not cached in the last day."""
    AUR_CACHE.mkdir(parents=True, exist_ok=True)
    out, need = {}, []
    for n in names:
        f = AUR_CACHE / f"{n}.json"
        if f.exists() and time.time() - f.stat().st_mtime < DAY:
            data = json.loads(f.read_text())
            if data:
                out[n] = data
        else:
            need.append(n)
    for i in range(0, len(need), 100):
        chunk = need[i:i + 100]
        q = "&".join("arg[]=" + urllib.parse.quote(n) for n in chunk)
        try:
            res = fetch_json(f"https://aur.archlinux.org/rpc/v5/info?{q}")["results"]
        except Exception:
            continue
        found = {r["Name"]: r for r in res}
        for n in chunk:
            (AUR_CACHE / f"{n}.json").write_text(json.dumps(found.get(n, {})))
            if n in found:
                out[n] = found[n]
    return out


def run(*cmd):
    return subprocess.run(cmd, capture_output=True, text=True)


def satisfied_installed(dep):
    return run("pacman", "-T", dep).returncode == 0


def satisfied_repo(dep):
    """Can Manjaro's repos (as configured) provide something satisfying dep?"""
    r = run("pacman", "-Sddp", "--print-format", "%n %v", dep)
    return r.returncode == 0 and r.stdout.strip() != ""


def split_dep(dep):
    m = re.match(r"^([^<>=]+)(?:([<>]=?|=)(.+))?$", dep)
    return (m.group(1), m.group(2), m.group(3)) if m else (dep, None, None)


def arch_package(name):
    """Arch's own package of that name (or the one that provides it)."""
    try:
        res = fetch_json(f"https://archlinux.org/packages/search/json/?name={urllib.parse.quote(name)}")["results"]
    except Exception:
        return None
    res = [r for r in res if r["repo"] in ("core", "extra", "multilib")]
    return res[0] if res else None


def vercmp(a, b):
    return int(run("vercmp", a, b).stdout.strip() or 0)


def arch_satisfies(pkg, op, ver):
    if not op:
        return True
    full = f"{pkg['epoch']}:{pkg['pkgver']}-{pkg['pkgrel']}" if pkg["epoch"] else f"{pkg['pkgver']}-{pkg['pkgrel']}"
    c = vercmp(full, ver) if "-" in ver else vercmp(f"{pkg['pkgver']}", ver)
    return {"=": c == 0, ">=": c >= 0, ">": c > 0, "<=": c <= 0, "<": c < 0}[op]


def plan(name, seen, order, aur=True):
    """Work out which dependencies of NAME have to be built from Arch's recipes."""
    if name in seen:
        return True
    seen.add(name)
    if aur:
        info = aur_info([name]).get(name)
        if not info:
            return True       # pamac will report it
        deps = info.get("Depends", []) + info.get("MakeDepends", [])
    else:
        pkg = arch_package(name)
        deps = (pkg or {}).get("depends", []) + (pkg or {}).get("makedepends", [])
    ok = True
    for dep in deps:
        if satisfied_installed(dep) or satisfied_repo(dep):
            continue
        dname, op, ver = split_dep(dep)
        if aur_info([dname]).get(dname):
            ok &= plan(dname, seen, order, aur=True)   # pamac builds AUR deps; check theirs too
            continue
        pkg = arch_package(dname)
        if pkg and arch_satisfies(pkg, op, ver):
            ok &= plan(pkg["pkgname"], seen, order, aur=False)
            if pkg["pkgbase"] not in [o["pkgbase"] for o in order]:
                order.append(pkg | {"wanted": dep})
            continue
        print(f"   {R}{dep}{N}: not in Manjaro stable, the AUR or Arch.")
        ok = False
    return ok


def build_from_arch(pkg):
    base = pkg["pkgbase"]
    d = SRC / base
    SRC.mkdir(parents=True, exist_ok=True)
    url = f"https://gitlab.archlinux.org/archlinux/packaging/packages/{base}.git"
    tag = (f"{pkg['epoch']}-" if pkg["epoch"] else "") + f"{pkg['pkgver']}-{pkg['pkgrel']}"
    if d.exists():
        subprocess.run(["git", "-C", str(d), "fetch", "-q", "--tags"])
    elif subprocess.run(["git", "clone", "-q", url, str(d)]).returncode:
        return False
    subprocess.run(["git", "-C", str(d), "checkout", "-q", tag.replace(":", "-")])
    say(f"Building {P}{base}{N} {tag} from Arch's recipe (needed by {pkg['wanted']})")
    if subprocess.run(["makepkg", "-si", "--needed", "--noconfirm", "--skippgpcheck"], cwd=d).returncode:
        return False
    names = pkg.get("pkgname")
    subprocess.run(["sudo", "mkdir", "-p", str(RECORD.parent)])
    line = f"{names} {tag} {time.strftime('%Y-%m-%d')}\n"
    subprocess.run(["sudo", "tee", "-a", str(RECORD)], input=line, text=True, stdout=subprocess.DEVNULL)
    return True


def check(name):
    order = []
    ok = plan(name, set(), order)
    if not order:
        return 0 if ok else 1
    say(f"{P}{name}{N} needs newer versions than Manjaro stable has:")
    for o in order:
        print(f"   {o['wanted']:<34} build {o['pkgbase']} {o['pkgver']} from Arch's recipe")
    print(f"   {D}Each is built once on this computer and replaced by Manjaro's own package when stable catches up.{N}")
    if not ok:
        print(f"   {R}Some dependencies can't be found anywhere, so the build may still fail.{N}")
    if input("   Build them now? [Y/n] ").strip().lower() in ("n", "no"):
        return 1
    for o in order:
        if not build_from_arch(o):
            print(f"   {R}Building {o['pkgbase']} failed.{N}")
            return 1
    return 0


def broken():
    """AUR packages whose ELF files have unresolved libraries, or Python
    packages built for an older Python."""
    foreign = run("pacman", "-Qmq").stdout.split()
    pyver = run("python3", "-c", "import sys;print(f'{sys.version_info[0]}.{sys.version_info[1]}')").stdout.strip()
    bad = {}
    for pkg in foreign:
        files = [f for f in run("pacman", "-Qlq", pkg).stdout.split("\n") if f and not f.endswith("/")]
        for f in files:
            m = re.match(r"/usr/lib/python(3\.\d+)/", f)
            if m and pyver and m.group(1) != pyver:
                bad[pkg] = f"built for Python {m.group(1)}"
                break
            if not (f.startswith(("/usr/bin/", "/usr/lib/", "/opt/"))) or not os.access(f, os.X_OK) and ".so" not in f:
                continue
            try:
                with open(f, "rb") as fh:
                    if fh.read(4) != b"\x7fELF":
                        continue
            except OSError:
                continue
            missing = [l.split()[0] for l in run("ldd", f).stdout.splitlines() if "not found" in l]
            if missing:
                bad[pkg] = "missing " + ", ".join(sorted(set(missing))[:3])
                break
    for pkg, why in bad.items():
        print(f"{pkg}\t{why}")
    return 1 if bad else 0


def main():
    if len(sys.argv) < 2:
        print(__doc__); return 2
    cmd, args = sys.argv[1], sys.argv[2:]
    if cmd == "check" and args:
        return check(args[0])
    if cmd == "broken":
        return broken()
    if cmd == "info" and args:
        print(json.dumps(aur_info(args))); return 0
    print(__doc__); return 2


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
