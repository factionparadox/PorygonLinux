#!/bin/sh
# Run (as porygon-power-source.service) by udev when the charger is plugged in or out (and at boot):
# power-saver on battery, balanced on mains. Changing the profile by hand
# still works; it's only switched again at the next plug/unplug.
command -v powerprofilesctl >/dev/null || exit 0
online=0
for s in /sys/class/power_supply/*; do
    [ "$(cat "$s/type" 2>/dev/null)" = Mains ] && [ "$(cat "$s/online" 2>/dev/null)" = 1 ] && online=1
done
# a desktop has no battery: leave it alone
ls /sys/class/power_supply/BAT* >/dev/null 2>&1 || exit 0
if [ $online = 1 ]; then p=balanced; else p=power-saver; fi
powerprofilesctl set $p
